# Required application configuration
NODE_ENV=development
PORT=3000

# NestJS Observe (optional; telemetry remains disabled unless both credentials are set)
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
OBSERVE_SERVICE_ID=data-pilot

# AI-assisted, development-only database query endpoint
# Required: the application does not start without a non-empty key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_REASONING_EFFORT=medium
MAX_ASK_SOURCES=10
MAX_ASK_SUMMARY_ROWS_PER_EXECUTION=100
MAX_ASK_SUMMARY_CONTENT_CHARS=50000

# NestJS Observe (optional; telemetry remains disabled unless both credentials are set)
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
OBSERVE_SERVICE_ID=data-pilot

# AI-assisted, development-only database query endpoint
OPENAI_API_KEY=
OPENAI_MODEL=
MAX_ASK_SOURCES=10
MAX_ASK_SUMMARY_ROWS_PER_EXECUTION=100
MAX_ASK_SUMMARY_CONTENT_CHARS=50000
